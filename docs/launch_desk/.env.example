# Launch Desk backend/runtime example.
# Copy the values you need into your local environment or into a private .env file.
# Do not commit real secrets.

# Required for live agent runs.
OPENAI_API_KEY=replace-with-your-openai-api-key

# Optional model/runtime controls.
LAUNCH_DESK_MODEL=gpt-5.4-mini
LAUNCH_DESK_MAX_TOKENS=3600
LAUNCH_DESK_MODEL_RETRIES=2
LAUNCH_DESK_VERBOSITY=medium
LAUNCH_DESK_REQUEST_TIMEOUT_SECONDS=120

# Local backend defaults.
LAUNCH_DESK_BACKEND_PORT=5057
LAUNCH_DESK_RATE_LIMIT_PER_MINUTE=12
LAUNCH_DESK_RATE_LIMIT_WINDOW_SECONDS=60

# Add production frontend origins here. Keep local defaults out of production allowlists.
# Example: https://launch-desk.example.com,https://preview-launch-desk.example.com
LAUNCH_DESK_ALLOWED_ORIGINS=

# Optional: only needed when the Agents SDK is installed into a workspace-local target.
# PowerShell example:
# $env:PYTHONPATH=".codex_tmpdeps\openai_agents"
